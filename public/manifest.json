{
  "manifest_version": 3,
  "name": "Recall — AI Bookmark Finder",
  "short_name": "Recall",
  "version": "0.2.1",
  "description": "Find anything you saved. Fast local bookmark search, smart metadata, duplicate review, and optional AI cleanup.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "bookmarks",
    "favicon",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "omnibox": {
    "keyword": "bm"
  },
  "commands": {
    "open-recall": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Recall bookmark finder"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Recall",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "optional_permissions": [
    "tabs"
  ]
}
